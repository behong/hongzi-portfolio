:80 {
	@www host www.hongzi.us

	handle @www {
		redir https://hongzi.us{uri} permanent
	}

	handle /index.html {
		redir https://hongzi.us/ permanent
	}

	handle /ai-trading.html {
		redir https://hongzi.us/post/ai-trading.html permanent
	}

	handle /kakao.html {
		redir https://hongzi.us/post/kakao-automation.html permanent
	}

	handle /seedance.html {
		redir https://hongzi.us/post/seedance.html permanent
	}

	handle /fpv.html {
		redir https://hongzi.us/post/fpv.html permanent
	}

	handle /private* {
		reverse_proxy private:8766
	}

	handle {
		root * /srv
		encode zstd gzip

		@static path *.webp *.jpg *.jpeg *.png *.gif *.svg *.ico *.woff2
		header @static Cache-Control "public, max-age=2592000"

		@html path / *.html
		header @html Cache-Control "public, max-age=0, must-revalidate"

		file_server
	}
}
